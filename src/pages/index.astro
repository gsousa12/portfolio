---
import ExperienceTimeline from '../components/ExperienceTimeline.astro';
import PortfolioTabs from '../components/PortfolioTabs.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { experiences, profile } from '../data/profile';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'gabs - blog';
---

<BaseLayout title={title} description={`Blog de ${profile.givenName} ${profile.familyName}, ${profile.role}.`}>
  <div class="content-shell">
    <main>
      <div class="profile-intro">
        <div class="profile-heading">
          <h1>{profile.givenName} | <span lang="en">{profile.role}</span></h1>
          <ThemeToggle />
        </div>
        <nav class="profile-links" aria-label="Redes sociais">
          <a
            class="icon-control"
            href={profile.linkedin.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`LinkedIn @${profile.linkedin.username}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.94 8.5H3.56V19h3.38V8.5ZM5.25 3A1.96 1.96 0 1 0 5.25 6.92 1.96 1.96 0 0 0 5.25 3ZM20.44 12.97c0-3.16-1.69-4.63-3.94-4.63a3.4 3.4 0 0 0-3.08 1.69V8.5h-3.38V19h3.38v-5.2c0-1.37.26-2.7 1.96-2.7 1.67 0 1.69 1.57 1.69 2.79V19h3.37v-6.03Z"></path>
            </svg>
          </a>
          <a
            class="icon-control"
            href={profile.github.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`GitHub @${profile.github.username}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.87c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.58 9.58 0 0 1 12 6.82a9.6 9.6 0 0 1 2.5.34c1.92-1.3 2.76-1.02 2.76-1.02.54 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z"></path>
            </svg>
          </a>
        </nav>
      </div>

      <PortfolioTabs />
      <ExperienceTimeline experiences={experiences} />
    </main>
  </div>
</BaseLayout>

<style>
  .content-shell {
    padding-block: var(--space-6) var(--section-space);
  }

  .profile-intro {
    --profile-icon-size: 2.25rem;
    margin-bottom: var(--space-2);
  }

  .profile-heading {
    display: flex;
    min-height: var(--target-size);
    align-items: center;
    justify-content: space-between;
  }

  h1 {
    margin: 0;
    font-size: clamp(var(--text-small), 4.4vw, 1rem);
    font-weight: 600;
  }

  .profile-links {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: var(--space-1);
  }

  .profile-links svg {
    width: var(--profile-icon-size);
    height: var(--profile-icon-size);
    fill: currentColor;
  }
</style>
